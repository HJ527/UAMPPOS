/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "paths": {
      "@pages": ["./src/app/pages"],
      "@components/atom": ["./src/app/components/atom"],
      "@components/molecule": ["./src/app/components/molecule"],
      "@components/organism": ["./src/app/components/organism"],
      "@shared/directives": ["./src/app/shared/directives"],
      "@shared/enums": ["./src/app/shared/enums"],
      "@shared/interfaces": ["./src/app/shared/interfaces"],
      "@shared/tokens": ["./src/app/shared/tokens"],
      "@shared/types": ["./src/app/shared/types"],
      "@shared/utils": ["./src/app/shared/utils"],
      "@theme/directives": ["./src/app/theme/directives"],
      "@theme/enums": ["./src/app/theme/enums"],
      "@theme/types": ["./src/app/theme/types"],
      "@theme": ["./src/app/theme/index.scss"],
      "@theme/*": ["./src/app/theme/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
